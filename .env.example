# 本地开发示例。复制为 .env.development.local 后按需调整，不覆盖已有环境文件。
# VITE_ 变量会进入浏览器产物，不得写入 Secret、Token 或服务端凭据。
VITE_APP_TITLE=MineAdmin
VITE_APP_PORT=2777
VITE_APP_ROOT_BASE=/
VITE_APP_ROUTE_MODE=hash
VITE_OPEN_PROXY=true
VITE_PROXY_PREFIX=/dev
VITE_APP_API_BASEURL=http://127.0.0.1:9601
VITE_BUILD_SOURCEMAP=false
