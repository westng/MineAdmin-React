{
  "name": "mineadmin-ui-react",
  "private": true,
  "version": "3.2.1",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "serve": "http-server ./dist -o",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{mjs,ts,tsx}\" \"scripts/**/*.{mjs,js,ts}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{mjs,ts,tsx}\" \"scripts/**/*.{mjs,js,ts}\" \"*.{js,ts,json}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "typecheck:ma": "tsc -p tsconfig.ma-components.json --pretty false",
    "lint:ma": "eslint src/components/ma-* --max-warnings=0",
    "test:ma": "node --test tests/ma-components.test.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "check:ma": "pnpm run typecheck:ma && pnpm run lint:ma && pnpm run test:ma",
    "typecheck:framework": "tsc -p tsconfig.ma-components.json --pretty false && tsc -b --pretty false",
    "check:boundaries": "node scripts/check-source-structure.mjs && node scripts/check-component-boundaries.mjs && node scripts/check-core-boundaries.mjs",
    "test:framework": "node --test tests/framework-*.test.mjs tests/component-boundaries.test.mjs tests/frontend-session.test.mjs tests/dashboard-slot.test.mjs",
    "check:framework": "pnpm run check:boundaries && pnpm run check:ma && pnpm run test:framework",
    "check:public-index": "node scripts/check-public-index.mjs",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "build:public-smoke": "node scripts/public-smoke.mjs",
    "export:public": "node scripts/export-public.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "^12.11.6",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.39.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.18.3",
    "recharts": "3.8.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "http-server": "^14.1.1",
    "prettier": "^3.9.7",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
